# 向量检索与智能缓存服务平台 - 环境变量配置示例
# 复制此文件为 .env 并填入实际值

# LLM配置
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-v4-pro
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.7
LLM_TIMEOUT=30

# Redis配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_MAX_CONNECTIONS=100

# 向量索引配置
VECTOR_DEFAULT_INDEX_NAME=vector_index
VECTOR_DEFAULT_DIMENSIONS=1536
VECTOR_DEFAULT_DISTANCE_METRIC=COSINE

# 缓存配置
CACHE_SEMANTIC_PREFIX=semantic_cache
CACHE_SEMANTIC_SIMILARITY_THRESHOLD=0.95
CACHE_SEMANTIC_DEFAULT_TTL=3600
CACHE_EMBEDDING_PREFIX=embedding_cache
CACHE_EMBEDDING_DEFAULT_TTL=86400

# 日志配置
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# 服务配置
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
SERVER_WORKERS=4
SERVER_DEBUG=false

# 安全配置
API_KEY_HEADER=X-API-Key
RATE_LIMIT=100